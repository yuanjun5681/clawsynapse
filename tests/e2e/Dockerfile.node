FROM golang:1.25-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -o /out/clawsynapsed ./cmd/clawsynapsed \
 && CGO_ENABLED=0 go build -o /out/clawsynapse ./cmd/clawsynapse

FROM alpine:3.21
RUN apk add --no-cache curl
COPY --from=build /out/clawsynapsed /usr/local/bin/clawsynapsed
COPY --from=build /out/clawsynapse /usr/local/bin/clawsynapse
COPY tests/e2e/fake-codex.sh /usr/local/bin/codex
RUN chmod 0755 /usr/local/bin/codex /usr/local/bin/clawsynapsed /usr/local/bin/clawsynapse
ENTRYPOINT ["/usr/local/bin/clawsynapsed"]
