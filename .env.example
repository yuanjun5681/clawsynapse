# Legacy single-Bot environment. Current daemons use schemaVersion 2 config.json;
# NODE_* names are preserved for legacy installations, not current Bot settings.
NATS_SERVERS=nats://127.0.0.1:4222
LOCAL_API_ADDR=127.0.0.1:18080
# Empty selects DATA_DIR/api.token; token contents never belong in this file.
API_TOKEN_PATH=
ALLOW_REMOTE_API=false
API_TLS_CERT_FILE=
API_TLS_KEY_FILE=
PRODUCTION=false
TRUST_MODE=tofu
TRUST_AUTO_APPROVE=false
AGENT_ADAPTER=default
AGENT_ALLOWED_IDS=
AGENT_ADAPTER_TIMEOUT=10m
HEARTBEAT_INTERVAL_MS=15000
ANNOUNCE_TTL_MS=30000
AGENT_PRODUCT=clawsynapse
AGENT_VERSION=
NODE_DISPLAY_NAME=
# JSON object; values are a string or a list of strings. "caps" is the
# reserved self-reported capability set.
NODE_LABELS={"env":"production","caps":["chat","tools"]}
# Deprecated: CSV still loads and folds into labels.caps when NODE_LABELS
# does not set caps.
# AGENT_CAPABILITIES=chat,tools
DATA_DIR=~/.clawsynapse
IDENTITY_KEY_PATH=~/.clawsynapse/identity.key
IDENTITY_PUB_PATH=~/.clawsynapse/identity.pub
DELIVERABLE_PREFIXES=chat,task
TRANSFER_DIR=~/.clawsynapse/transfers
TRANSFER_MAX_FILE_SIZE=104857600
TRANSFER_TTL=24h
NATS_CREDENTIALS_FILE=
NATS_TLS_CA_FILE=
NATS_TLS_CERT_FILE=
NATS_TLS_KEY_FILE=
NATS_TLS_SERVER_NAME=
WEBHOOK_AUTH_TOKEN=
